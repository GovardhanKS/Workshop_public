# Copy this file to `.env` and fill in values as needed.
# Omit entirely (or leave blank) to run fully offline with the safe
# defaults: extractive (no-LLM) generation + TF-IDF retrieval -- zero
# setup, no API key required.

# Set to "llm" to use a hosted/local LLM instead of the extractive default.
LLM_MODE=extractive

# Any OpenAI-compatible endpoint works: Groq, Ollama, llama.cpp, HF Inference.
# Example for Groq:
#   OPENAI_API_BASE=https://api.groq.com/openai/v1
#   MODEL_NAME=openai/gpt-oss-20b
#   OPENAI_API_KEY=<your Groq key>
OPENAI_API_BASE=http://localhost:11434/v1
MODEL_NAME=llama3.1
OPENAI_API_KEY=not-needed-for-local-ollama

# tfidf (default, offline) or hf (sentence-transformers + Chroma, needs
# requirements-hf.txt)
EMBEDDING_BACKEND=tfidf

# Set to 1 to cross-encoder rerank retrieval results (needs requirements-hf.txt)
RERANK=0
