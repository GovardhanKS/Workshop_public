.venv/
__pycache__/
*.pyc
.git/
.gitignore
*.log

# Secrets -- never bake API keys into an image layer. Passed at container
# runtime instead via docker-compose.yml's `environment:` (which reads
# ./.env for ${VAR} substitution automatically -- that .env is still read
# from the host, just never COPYed into the image).
.env
.env.local
.env.*

# Not needed inside the container
*.pptx
data/query_log.jsonl
data/feedback_log.jsonl
*.backup-*/
